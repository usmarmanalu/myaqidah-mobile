<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".ui.home.ArtikelActivity">

    <!-- NestedScrollView untuk konten yang bisa di-scroll -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Article Image -->
            <ImageView
                android:id="@+id/artikelImageView"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:contentDescription="@string/article_image"
                android:scaleType="centerCrop"
                android:transitionName="image"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <!-- Title Text -->
            <TextView
                android:id="@+id/titleTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Article Title"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:transitionName="title"
                app:layout_constraintTop_toBottomOf="@id/artikelImageView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Separator Line -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginVertical="8dp"
                android:background="@color/grey"
                app:layout_constraintTop_toBottomOf="@id/titleTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Article Content -->
            <TextView
                android:id="@+id/artikelTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="8dp"
                android:text="This is the content of the article, providing a detailed description and information."
                android:textSize="16sp"
                android:lineSpacingExtra="6dp"
                android:textAlignment="gravity"
                android:textColor="@color/black"
                android:transitionName="artikel"
                app:layout_constraintTop_toBottomOf="@id/titleTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Uploaded Date Text -->
            <TextView
                android:id="@+id/uploadedTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Uploaded: 20 Oct 2024"
                android:textSize="14sp"
                android:textColor="@color/grey"
                android:textAlignment="center"
                android:transitionName="uploaded"
                app:layout_constraintTop_toBottomOf="@id/artikelTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Reference Text -->
            <TextView
                android:id="@+id/referensiTitleTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Referensi:"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:textColor="@color/black"
                android:textAlignment="viewStart"
                android:transitionName="referensi"
                app:layout_constraintTop_toBottomOf="@id/uploadedTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/referensiTextView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Source: www.example.com"
                android:textSize="12sp"
                android:textStyle="italic"
                android:textColor="@color/green"
                android:textAlignment="viewStart"
                android:transitionName="referensi"
                app:layout_constraintTop_toBottomOf="@id/referensiTitleTextView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
